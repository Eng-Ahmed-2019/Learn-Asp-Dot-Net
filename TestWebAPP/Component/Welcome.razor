@page "/"
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Home - Page</PageTitle>

<div class="home-page">
    <div class="welcome-card">

        <div class="logo">✦</div>

        <span class="welcome-badge">WELCOME TO TESTWEBAPP</span>

        <h1>
            Build Something
            <span class="gradient-text">Amazing.</span>
        </h1>

        <p class="description">
            Welcome! Your journey into web development starts here.
            Explore the app, try the interactive counter,
            and discover what you can build with Blazor.
        </p>

        <div class="actions">
            <a href="/Counter" class="primary-btn">
                Counter-Page <span>→</span>
            </a>

            <a href="/index.html" class="primary-btn">
                Welcome-Page <span>→</span>
            </a>

            <a href="/swagger/index.html" class="primary-btn">
                Swagger-Page <span>→</span>
            </a>

            <a href="#features" class="secondary-btn">
                Learn More
            </a>
        </div>

        <div class="divider"></div>

        <div id="features" class="features">
            <div class="feature">
                <div class="feature-icon blue">⚡</div>
                <h3>Fast</h3>
                <p>Responsive experience</p>
            </div>

            <div class="feature">
                <div class="feature-icon purple">✧</div>
                <h3>Modern</h3>
                <p>Clean, simple design</p>
            </div>

            <div class="feature">
                <div class="feature-icon green">⌘</div>
                <h3>Interactive</h3>
                <p>Powered by Blazor</p>
            </div>
        </div>

        <div class="footer">
            <span>Made with Blazor</span>
            <span>© 2026 TestWebAPP</span>
        </div>

    </div>
</div>

<style>
    .home-page {
        min-height: 85vh;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 35px 18px;
        font-family: "Segoe UI", sans-serif;
        background: radial-gradient(circle at 10% 10%, #dbeafe, transparent 35%), radial-gradient(circle at 90% 90%, #ede9fe, transparent 35%), #f8fafc;
    }

    .welcome-card {
        width: 100%;
        max-width: 850px;
        padding: 48px;
        text-align: center;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid #e2e8f0;
        border-radius: 28px;
        box-shadow: 0 24px 70px rgba(30, 41, 59, 0.10);
    }

    .logo {
        width: 66px;
        height: 66px;
        margin: 0 auto 22px;
        display: grid;
        place-items: center;
        border-radius: 21px;
        color: white;
        font-size: 35px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 10px 25px rgba(79, 70, 229, 0.25);
    }

    .welcome-badge {
        display: inline-block;
        padding: 8px 14px;
        border-radius: 30px;
        color: #4338ca;
        background: #eef2ff;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
    }

    .welcome-card h1 {
        margin: 24px 0 16px;
        color: #0f172a;
        font-size: clamp(34px, 6vw, 58px);
        font-weight: 850;
        line-height: 1.15;
        letter-spacing: -1.5px;
    }

    .gradient-text {
        display: block;
        color: #4f46e5;
        background: linear-gradient(90deg, #2563eb, #9333ea);
        background-clip: text;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        max-width: 550px;
        margin: 0 auto;
        color: #64748b;
        font-size: 16px;
        line-height: 1.9;
    }

    .actions {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 12px;
        margin-top: 30px;
    }

        .actions a {
            padding: 14px 22px;
            border-radius: 12px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 700;
            transition: transform 0.2s, box-shadow 0.2s;
        }

            .actions a:hover {
                transform: translateY(-3px);
            }

    .primary-btn {
        color: white;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.2);
    }

        .primary-btn span {
            margin-left: 8px;
        }

    .secondary-btn {
        color: #334155;
        background: white;
        border: 1px solid #e2e8f0;
    }

    .divider {
        height: 1px;
        margin: 38px 0 28px;
        background: #e2e8f0;
    }

    .features {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
    }

    .feature {
        padding: 18px 8px;
        border-radius: 18px;
        transition: background 0.2s;
    }

        .feature:hover {
            background: #f8fafc;
        }

    .feature-icon {
        width: 46px;
        height: 46px;
        margin: 0 auto 12px;
        display: grid;
        place-items: center;
        border-radius: 14px;
        font-size: 24px;
        font-weight: bold;
    }

    .blue {
        color: #2563eb;
        background: #dbeafe;
    }

    .purple {
        color: #7c3aed;
        background: #ede9fe;
    }

    .green {
        color: #059669;
        background: #d1fae5;
    }

    .feature h3 {
        margin: 0 0 7px;
        color: #1e293b;
        font-size: 16px;
    }

    .feature p {
        margin: 0;
        color: #64748b;
        font-size: 12px;
    }

    .footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #f1f5f9;
        color: #94a3b8;
        font-size: 12px;
    }

    @@media (max-width: 600px) {
        .welcome-card {
            padding: 30px 18px;
        }

        .features {
            grid-template-columns: 1fr;
            gap: 5px;
        }

        .feature {
            padding: 14px;
        }

        .footer {
            flex-direction: column;
        }
    }
</style>